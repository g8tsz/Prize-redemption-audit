# Database
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3002

# Optional: base URL for payment API (for reconciliation)
PAYMENT_API_URL=
PAYMENT_API_KEY=

# Optional: base URL for KYC API (for reconciliation / fraud)
KYC_API_URL=
KYC_API_KEY=

# Fraud: max redemptions per user per 24h (0 = no limit)
FRAUD_VELOCITY_MAX_COUNT_24H=10
FRAUD_VELOCITY_MAX_AMOUNT_24H=50000
