{
  "name": "prize-redemption-audit",
  "version": "1.0.0",
  "description": "Immutable prize/redemption audit log with reconciliation and fraud checks for sweepstakes and crypto casinos",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "reconcile:run": "tsx src/jobs/reconcileRunner.ts",
    "audit:verify": "tsx src/jobs/verifyAuditChain.ts"
  },
  "keywords": ["redemption", "prize", "audit", "sweepstakes", "casino", "compliance", "reconciliation", "fraud"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
